# CAREGRAPH Environment Variables
# Copy this file to .env and fill in real values for production
# NEVER commit .env with real credentials or secrets

# Runtime Mode: 'demo' (synthetic in-memory) or 'production' (live backend)
VITE_CAREGRAPH_MODE=demo

# Authentication Provider: 'demo' or 'oidc'
VITE_AUTH_PROVIDER=demo
# VITE_OAUTH_CLIENT_ID=your-oauth-client-id
# VITE_OAUTH_AUTHORITY=https://your-identity-provider.com
VITE_SESSION_TIMEOUT_MINUTES=30

# Backend API Configuration (Production Only)
# VITE_API_BASE_URL=https://api.caregraph.health/v1
# VITE_API_TIMEOUT=30000

# NOTE: AI/LLM API keys (e.g. Gemini, OpenAI) must NEVER be placed in VITE_ variables
# All model inference and extraction runs behind a secure backend proxy
# See docs/AI-SECURITY.md for architecture details
