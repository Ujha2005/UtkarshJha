# CAREGRAPH Environment Variables
# Copy this file to .env and fill in real values for production
# NEVER commit .env with real credentials

# Authentication (Production Only)
# VITE_AUTH_PROVIDER=demo
# VITE_OAUTH_CLIENT_ID=your-oauth-client-id
# VITE_OAUTH_AUTHORITY=https://your-identity-provider.com

# Backend API (Production Only)  
# VITE_API_BASE_URL=http://localhost:3001/api
# VITE_API_TIMEOUT=30000

# NOTE: AI/LLM API keys should NEVER be in VITE_ variables
# They must be configured on the backend server only
# See docs/AI-SECURITY.md for details
